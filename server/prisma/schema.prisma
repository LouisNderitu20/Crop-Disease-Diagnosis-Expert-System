generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String
  role      String   @default("FARMER") // ADMIN or FARMER
  history   Diagnosis[]
  feedback  Feedback[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Crop {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  symptoms  Symptom[]
  rules     Rule[]
  diagnoses Diagnosis[]
}

model Symptom {
  id          Int      @id @default(autoincrement())
  symptomId   String   
  description String
  cropId      Int
  crop        Crop     @relation(fields: [cropId], references: [id])

  @@unique([symptomId, cropId])
}

model Disease {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  treatment   String
  prevention  String
  facts       String?
  rules       Rule[]
  diagnoses   Diagnosis[]
}

model Rule {
  id                   Int     @id @default(autoincrement())
  ruleId               String  @unique 
  cropId               Int
  crop                 Crop    @relation(fields: [cropId], references: [id])
  conditionSymptoms    String
  conditionEnv         String?
  diseaseId            Int
  disease              Disease @relation(fields: [diseaseId], references: [id])
  confidence           Float
}

model Diagnosis {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  date       DateTime @default(now())
  cropId     Int
  crop       Crop     @relation(fields: [cropId], references: [id])
  symptoms   String  
  diseaseId  Int
  disease    Disease  @relation(fields: [diseaseId], references: [id])
  confidence Float
  image      String?  // Path to the leaf photo
}

model Feedback {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  diagnosisId Int
  rating      Int      // 1-5 scale or similar
  comment     String?
  createdAt   DateTime @default(now())
}
